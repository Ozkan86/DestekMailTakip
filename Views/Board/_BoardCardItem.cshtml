@model (BoardCard Card, int BoardId, string ListKey, bool IsEngineer, bool CanAddCard, string CurrentUserId)
@inject IUserAvatarColorService AvatarColors
@{
    var card = Model.Card;
    var key = Model.ListKey;
    var boardId = Model.BoardId;
    var isEngineer = Model.IsEngineer;
    var canAddCard = Model.CanAddCard;
    var currentUserId = Model.CurrentUserId;

    // Surukle-birak: mühendis kendine atadigi Yapilacaklar kartini Test'e,
    // musteri Test kartini Yapilacaklar'a (red) veya Tamamlanan'a (onay) surukleyebilir.
    var canDragToTest = key == BoardLists.Todo && isEngineer && card.IsAssigned && card.AssignedUserId == currentUserId;
    var canDragAsCustomer = key == BoardLists.Test && canAddCard;
    var dragRole = canDragToTest ? "engineer-move-test" : (canDragAsCustomer ? "customer-test-card" : null);
    var dragAttributes = dragRole is not null ? $"draggable=\"true\" data-drag-role=\"{dragRole}\"" : string.Empty;

    // Klasik'te mühendisin kart "uzerine alabilecegi" tek liste Yapilacaklar'dir.
    var claimEligibleHere = key == BoardLists.Todo && isEngineer;
    var showClaimIcon = claimEligibleHere && !card.IsAssigned;
    var isMine = card.IsAssigned && card.AssignedUserId == currentUserId;
    var showReleaseIcon = claimEligibleHere && isMine;
    var releaseActive = showReleaseIcon && key == card.AssignedListKey;
}
<div class="board-card@(card.HasCover ? " has-cover" : "")@((showClaimIcon || showReleaseIcon) ? " has-claim-action" : "")" data-card-id="@card.Id" data-board-id="@boardId" data-list-key="@key" @Html.Raw(dragAttributes)>
    <button type="button" class="board-card-edit-btn" data-card-id="@card.Id" data-board-id="@boardId" title="Kartı düzenle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" /></svg>
    </button>

    @if (showClaimIcon)
    {
        <form asp-action="AssignToMe" asp-route-cardId="@card.Id" asp-route-boardId="@boardId" method="post" class="board-card-claim-form js-generic-move-form">
            <button type="submit" class="board-card-claim-btn" title="Üstüme Al">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="16" y1="11" x2="22" y2="11" /></svg>
            </button>
        </form>
    }
    else if (showReleaseIcon)
    {
        <form asp-action="ReleaseFromMe" asp-route-cardId="@card.Id" asp-route-boardId="@boardId" method="post" class="board-card-claim-form js-generic-move-form">
            <button type="submit" class="board-card-claim-btn" @(releaseActive ? "" : "disabled")
                    title="@(releaseActive ? "Üstümden Bırak" : "Kartı sadece ilk üzerine aldığınız listede bırakabilirsiniz")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="16" y1="11" x2="22" y2="11" /></svg>
            </button>
        </form>
    }

    @if (card.IsAssigned)
    {
        <span class="board-card-assignee-tooltip">
            <span class="avatar-circle" style="background:@AvatarColors.ColorFor(card.AssignedUserId, card.AssignedUserDisplayName)">@AvatarHelper.Initials(card.AssignedUserDisplayName, card.AssignedUserDisplayName)</span>
            @card.AssignedUserDisplayName
        </span>
    }

    @if (card.CoverImagePath is not null)
    {
        <div class="board-card-cover board-card-cover-image" style="background-image:url('@card.CoverImagePath');"></div>
    }
    else if (card.CoverColor is not null)
    {
        <div class="board-card-cover board-card-cover-color" style="background:@card.CoverColor;"></div>
    }

    @if (card.Labels.Any())
    {
        <div class="board-card-labels">
            @foreach (var cardLabel in card.Labels)
            {
                <span class="board-card-label-strip" data-label-id="@cardLabel.Id" style="background:@cardLabel.Color;">@cardLabel.Name</span>
            }
        </div>
    }

    <div class="board-card-title">@card.Title</div>
    @if (card.DescriptionPreview is not null)
    {
        <div class="board-card-desc">@card.DescriptionPreview</div>
    }
    <div class="board-card-meta">
        <span class="status-badge status-badge-unassigned">@card.CreatedByDisplayName</span>
        @if (card.RejectedCount > 0)
        {
            <span class="status-badge status-badge-pending" title="@card.LastRejectionNote">Reddedildi (@card.RejectedCount)</span>
        }
    </div>

    @if (key == BoardLists.Todo && isEngineer && card.IsAssigned && card.AssignedUserId == currentUserId)
    {
        <div class="board-card-actions">
            <form asp-action="MoveToTest" asp-route-cardId="@card.Id" asp-route-boardId="@boardId" method="post" class="js-move-to-test-form">
                <button type="submit" class="btn-chip">Teste Taşı</button>
            </form>
        </div>
    }

    @if (key == BoardLists.Test && canAddCard)
    {
        <div class="board-card-actions">
            <form asp-action="Approve" asp-route-cardId="@card.Id" asp-route-boardId="@boardId" method="post" class="js-approve-form">
                <button type="submit" class="btn-chip btn-chip-primary">Onayla</button>
            </form>
            @* Gerekce, karti sisiren acilir bir kutu yerine surukle-birakta
               kullanilan pencerenin aynisinda soruluyor (bkz. ui-dialog.js);
               kartta yalnizca Onayla / Reddet butonlari kalir. *@
            <form asp-action="Reject" asp-route-cardId="@card.Id" asp-route-boardId="@boardId" method="post" class="js-reject-form"
                  data-ui-prompt-title="Kartı reddet"
                  data-ui-prompt="Kart &quot;Yapılacaklar&quot; listesine geri gönderilecek. Mühendisin ne yapması gerektiğini kısaca yazın."
                  data-ui-prompt-label="Reddetme sebebi"
                  data-ui-prompt-placeholder="Örn. Test ortamında hata devam ediyor."
                  data-ui-prompt-required-message="Reddetmek için bir açıklama girmelisiniz."
                  data-ui-prompt-field="Note"
                  data-ui-prompt-ok="Reddet"
                  data-ui-prompt-tone="warning">
                <input type="hidden" name="Note" />
                <button type="submit" class="btn-chip btn-chip-danger">Reddet</button>
            </form>
        </div>
    }

    @if (key == BoardLists.Done && card.CompletedAt is not null)
    {
        <div class="board-list-item-meta">Tamamlandı: @card.CompletedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
    }
</div>
