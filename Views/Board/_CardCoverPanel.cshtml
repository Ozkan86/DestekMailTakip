@model CardCoverPanelModel
<div class="board-card-menu-surface">
    <div class="board-card-menu-header">
        <span class="board-card-menu-title">Kapak</span>
        <button type="button" class="board-card-menu-close-btn" title="Kapat">&times;</button>
    </div>

    <div class="board-cover-section">
        <div class="board-cover-section-heading">Renkler</div>
        <div class="board-cover-color-row">
            @foreach (var (value, label) in BoardCoverColors.Palette)
            {
                var selected = string.Equals(value, Model.CoverColor, StringComparison.OrdinalIgnoreCase);
                <button type="button"
                        class="board-cover-color-swatch@(selected ? " selected" : "")"
                        data-board-id="@Model.BoardId" data-card-id="@Model.CardId" data-color="@value"
                        style="background:@value;" title="@label"></button>
            }
        </div>
        @if (Model.CoverColor is not null || Model.CoverImagePath is not null)
        {
            <button type="button" class="board-cover-remove-btn" data-board-id="@Model.BoardId" data-card-id="@Model.CardId">Kapağı Kaldır</button>
        }
    </div>

    <div class="board-cover-section">
        <div class="board-cover-section-heading">Eklentiler</div>

        <button type="button" class="board-cover-upload-btn" data-board-id="@Model.BoardId" data-card-id="@Model.CardId">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
            <span>Kapak resmi seçin</span>
        </button>
        <input type="file" class="board-cover-file-input" accept="image/*" data-board-id="@Model.BoardId" data-card-id="@Model.CardId" style="display:none;" />

        <div class="board-cover-preset-heading">Sana paylaştığım fotoğraflar</div>
        <div class="board-cover-preset-grid">
            @foreach (var (key, path) in BoardCoverPresets.All)
            {
                var selected = string.Equals(path, Model.CoverImagePath, StringComparison.OrdinalIgnoreCase);
                <button type="button"
                        class="board-cover-preset-thumb@(selected ? " selected" : "")"
                        data-board-id="@Model.BoardId" data-card-id="@Model.CardId" data-preset-key="@key"
                        style="background-image:url('@path');" title="Kapak resmi"></button>
            }
        </div>
    </div>
</div>
