@{
    var boardId = ViewData["BoardId"];
    var cardId = ViewData["CardId"];
    var canDeleteCard = ViewData["CanDeleteCard"] as bool? ?? false;
    var cannotDeleteCardReason = ViewData["CannotDeleteCardReason"] as string ?? "Bu listede kart ekleme yetkiniz olmadığı için kartı silemezsiniz.";
}
<div class="board-card-menu-options">
    <button type="button" class="board-card-menu-option" data-action="open" data-board-id="@boardId" data-card-id="@cardId">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
        <span>Kartı Aç</span>
    </button>
    <button type="button" class="board-card-menu-option" data-action="edit-labels" data-board-id="@boardId" data-card-id="@cardId">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 13.42 20.59a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z"/><line x1="7" y1="7" x2="7" y2="7"/></svg>
        <span>Etiketleri Düzenle</span>
    </button>
    <button type="button" class="board-card-menu-option" data-action="change-cover" data-board-id="@boardId" data-card-id="@cardId">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
        <span>Kapağı Değiştir</span>
    </button>
    <button type="button" class="board-card-menu-option" data-action="archive" data-board-id="@boardId" data-card-id="@cardId">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8v13H3V8"/><path d="M1 3h22v5H1z"/><path d="M10 12h4"/></svg>
        <span>Arşiv</span>
    </button>
    <button type="button" class="board-card-menu-option board-card-menu-option-danger" data-action="delete" data-board-id="@boardId" data-card-id="@cardId"
            @(canDeleteCard ? "" : "disabled")
            title="@(canDeleteCard ? "Kartı kalıcı olarak sil" : cannotDeleteCardReason)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
        <span>Kartı Sil</span>
    </button>
</div>
