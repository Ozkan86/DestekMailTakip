@model RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = "_AuthLayout";
}

<div class="auth-wrapper">
    <div class="auth-brand-panel">
        <div class="auth-brand-logo">
            <img src="~/assets/creamobile-logo.png" alt="Creamobile" />
        </div>

        <div class="auth-brand-copy">
            <h1>Her zaman elinden gelenin en iyisini yap</h1>
        </div>

        <div class="auth-brand-footer">
            &copy; @DateTime.Now.Year Creamobile &mdash; Destek Mail Sistemi
        </div>
    </div>

    <div class="auth-form-panel">
        <div class="auth-outer-card">
            <div class="auth-icon-badge">
                <img src="~/assets/creamobile-icon.png" alt="Creamobile" />
            </div>

            <div class="auth-tabs">
                <a class="auth-tab" asp-action="Login">Giriş Yap</a>
                <a class="auth-tab active" asp-action="Register">Kayıt Ol</a>
            </div>

            <div class="auth-inner-card">
                <h2>Hesap Oluştur</h2>
                <p class="subtitle">Görev panolarınızı oluşturmak için kayıt olun.</p>

                <form asp-action="Register" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" style="display:none"></div>

                    <div class="mb-3">
                        <label asp-for="DisplayName" class="form-label"></label>
                        <input asp-for="DisplayName" class="form-control" placeholder="Ad Soyad" autocomplete="name" />
                        <span asp-validation-for="DisplayName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="ornek@sirket.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" placeholder="********" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="********" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="auth-btn-primary">Kayıt Ol</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Sunucudan gelen validation-summary hata içeriyorsa göster.
        (function () {
            var summary = document.querySelector('.validation-summary-errors');
            if (summary) {
                summary.closest('.alert').style.display = 'block';
            }
        })();
    </script>
}
